[Unit]
Description=BioFusion Streamlit App (pneumonia detection web UI)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/biofusion/streamlit_app
Environment="PATH=/var/www/biofusion/venv/bin"
Environment="HOME=/var/www/biofusion"
Environment="STREAMLIT_BROWSER_GATHER_USAGE_STATS=false"
ExecStart=/var/www/biofusion/venv/bin/streamlit run app.py \
    --server.port 8502 \
    --server.address 127.0.0.1 \
    --server.baseUrlPath /app \
    --server.headless true \
    --server.enableCORS false \
    --server.enableXsrfProtection false
Restart=always
RestartSec=5
# 1 vCPU / 961MB box: cap so a runaway process cannot take the whole droplet down
MemoryMax=1200M

[Install]
WantedBy=multi-user.target
